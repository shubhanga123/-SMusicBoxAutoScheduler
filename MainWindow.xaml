<Window x:Class="SMusicBoxAutoScheduler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S-Music Box Auto Scheduler"
        Width="1440" Height="900" MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" Foreground="#172033"
        FontFamily="Segoe UI" FontSize="14">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#1E40AF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#C7D2E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8EEF6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#526078"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="NavBorder" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#EFF4FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="NavBorder" Property="Background" Value="#E3ECFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172033"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#263449"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6"/>
            <Setter Property="VerticalGridLinesBrush" Value="#FFFFFF"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="12,13"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E8EDF3"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="246"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT NAVIGATION -->
        <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,12,0">
                    <Border Width="42" Height="42" CornerRadius="12" Background="#EAF1FF" VerticalAlignment="Center">
                        <TextBlock Text="S" Foreground="#2563EB" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="S-MUSIC BOX" FontSize="15" FontWeight="Bold" Foreground="#172033"/>
                        <TextBlock Text="AUTO SCHEDULER" FontSize="9" FontWeight="Bold" Foreground="#8190A5" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="15,12,15,12">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="12,0,0,9"/>
                    <Button Style="{StaticResource NavigationButton}" Click="NavDashboard_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="19" Width="28"/><TextBlock Text="Dashboard" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Click="NavQueue_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="☷" FontSize="18" Width="28"/><TextBlock Text="Publishing queue" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Click="NavFiles_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="18" Width="28"/><TextBlock Text="Media files" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavigationButton}" Click="NavHistory_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="◷" FontSize="19" Width="28"/><TextBlock Text="Upload history" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                    <Border Height="1" Background="#EEF2F6" Margin="8,17,8,15"/>
                    <TextBlock Text="PREFERENCES" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="12,0,0,9"/>
                    <Button Style="{StaticResource NavigationButton}" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="28"/><TextBlock Text="Settings" VerticalAlignment="Center"/></StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="15,10,15,18">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="13">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0"/>
                                <TextBlock Text="YOUTUBE ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtAuthStatus" Text="Checking connection…" FontSize="12" Foreground="#334155"
                                       TextWrapping="Wrap" Margin="0,10,0,10"/>
                            <Button x:Name="BtnAuthConnect" Content="Connect YouTube" Style="{StaticResource SecondaryButton}"
                                    Height="36" HorizontalAlignment="Stretch" Click="BtnAuthConnect_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="S-Music Box • Desktop" FontSize="10" Foreground="#94A3B8" Margin="5,13,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN AREA -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid Margin="27,0,27,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtViewTitle" Text="Dashboard" FontSize="19" FontWeight="SemiBold" Foreground="#172033"/>
                        <TextBlock Text="Manage your video publishing workflow" FontSize="11" Foreground="#8190A5" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,12,0">
                            <TextBlock Text="NEPAL TIME  ·  UTC +5:45" FontSize="10" FontWeight="Bold" Foreground="#526078"/>
                        </Border>
                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Click="BtnRefresh_Click" Height="38"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTENT PANELS: each named panel itself is the ScrollViewer so visibility is controlled directly -->
            <Grid Grid.Row="1" Background="#F4F6FA">

                <!-- DASHBOARD -->
                <ScrollViewer x:Name="PanelDashboard" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="28,24,28,30">
                        <Grid Margin="0,0,0,19">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Publishing overview" FontSize="23" FontWeight="Bold" Foreground="#172033"/>
                                <TextBlock Text="A clear view of your videos, queue and publishing activity." FontSize="13" Foreground="#64748B" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="13,9" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="#F59E0B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="UPLOADS CONTROLLED MANUALLY" FontSize="11" FontWeight="SemiBold" Foreground="#526078" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- STATS -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="TOTAL VIDEOS" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                                        <TextBlock x:Name="LblStatTotal" Text="0" FontSize="30" FontWeight="Bold" Foreground="#172033" Margin="0,8,0,0"/>
                                        <TextBlock Text="Tracked in your library" FontSize="11" Foreground="#8491A4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="#EAF1FF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="▤" FontSize="21" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PENDING" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                                        <TextBlock x:Name="LblStatPending" Text="0" FontSize="30" FontWeight="Bold" Foreground="#B45309" Margin="0,8,0,0"/>
                                        <TextBlock Text="Waiting to be published" FontSize="11" Foreground="#8491A4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="#FFF5E6" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="◷" FontSize="22" Foreground="#C17A14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="COMPLETED" FontSize="10" FontWeight="Bold" Foreground="#718096"/>
                                        <TextBlock x:Name="LblStatCompleted" Text="0" FontSize="30" FontWeight="Bold" Foreground="#15803D" Margin="0,8,0,0"/>
                                        <TextBlock Text="Successfully uploaded" FontSize="11" Foreground="#8491A4" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="11" Background="#EAF7EF" HorizontalAlignment="Right" VerticalAlignment="Top">
                                        <TextBlock Text="✓" FontSize="20" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- WORKER CONTROL -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="17">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Ellipse Width="9" Height="9" Fill="#F59E0B" Margin="0,0,9,0"/>
                                        <TextBlock Text="PUBLISHING WORKER" FontSize="11" FontWeight="Bold" Foreground="#64748B"/>
                                    </StackPanel>
                                    <TextBlock Text="Manage background publishing" FontSize="16" FontWeight="SemiBold" Foreground="#172033" Margin="0,7,0,2"/>
                                    <TextBlock Text="Start or pause the background worker when you are ready to process eligible queue items." FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button x:Name="BtnStartWorker" Grid.Column="1" Content="Start uploads" Style="{StaticResource PrimaryButton}"
                                        Width="140" VerticalAlignment="Center" Click="BtnToggleWorker_Click" Margin="15,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- RECENT VIDEOS -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="18,16,18,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Recent videos" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="The latest items added to your publishing workflow" FontSize="11" Foreground="#8491A4" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="View queue" Style="{StaticResource SecondaryButton}" Height="34" Click="NavQueue_Click"/>
                                </Grid>
                                <DataGrid x:Name="GridRecentVideos" Grid.Row="1" MinHeight="155" MaxHeight="260"
                                          AutoGenerateColumns="False" Margin="8,0,8,8" RowHeight="66">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="THUMBNAIL" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="68" Height="48" CornerRadius="5" Background="#EEF2F6" ClipToBounds="True" HorizontalAlignment="Left">
                                                        <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="VIDEO TITLE" Binding="{Binding Title}" Width="*"/>
                                        <DataGridTextColumn Header="SCHEDULED" Binding="{Binding ScheduledTime}" Width="205"/>
                                        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="135"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <!-- WORKFLOW / 5:7 COLUMNS -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="5*"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                <StackPanel>
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#EAF1FF" HorizontalAlignment="Left" Margin="0,0,0,12">
                                        <TextBlock Text="↑" FontSize="23" FontWeight="SemiBold" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Publish a local video" Style="{StaticResource SectionHeading}"/>
                                    <TextBlock Text="Add a video stored on this computer. The guided process collects its title, description, thumbnail and publishing time." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,15"/>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="11" Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="PUBLISHING STEPS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                                            <TextBlock Text="1. Select video   2. Add details" FontSize="11" Foreground="#526078" Margin="0,7,0,0"/>
                                            <TextBlock Text="3. Thumbnail   4. Schedule last" FontSize="11" Foreground="#526078" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Choose video &amp; continue" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch" Click="BtnAddVideo_Click"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="10" Background="#EAF7EF" Margin="0,0,12,0">
                                                <TextBlock Text="↧" FontSize="23" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Import from YouTube link" Style="{StaticResource SectionHeading}"/>
                                                <TextBlock Text="Download and add a video to your queue" FontSize="11" Foreground="#8491A4" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#F0F7FF" CornerRadius="6" Padding="9,6" VerticalAlignment="Center">
                                            <TextBlock Text="LINK IMPORT" FontSize="9" FontWeight="Bold" Foreground="#2563EB"/>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="YOUTUBE VIDEO URL" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="TxtVideoLink" Height="42" Margin="0,0,0,14" ToolTip="Paste a YouTube video link"/>

                                    <TextBlock Text="PUBLISHING SCHEDULE" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,9,0">
                                            <TextBlock Text="DATE" FontSize="10" Foreground="#8491A4" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <DatePicker x:Name="PickerPublishDate" Height="42" HorizontalContentAlignment="Left"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,9,0">
                                            <TextBlock Text="HOUR" FontSize="10" Foreground="#8491A4" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="ComboHour" Height="42" MinWidth="75"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="MINUTE" FontSize="10" Foreground="#8491A4" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                            <ComboBox x:Name="ComboMinute" Height="42" MinWidth="75"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Background="#F8FAFC" BorderBrush="#E7EDF4" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,13">
                                        <StackPanel>
                                            <TextBlock Text="SCHEDULE PREVIEW" FontSize="9" FontWeight="Bold" Foreground="#8491A4"/>
                                            <TextBlock x:Name="LblSelectedSchedule" Text="Choose a date and time" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,4,0,0"/>
                                            <TextBlock x:Name="TxtScheduleTime" Text="Nepal Time (UTC+5:45)" FontSize="10" Foreground="#64748B" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button Content="Import link &amp; add to queue" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch" Click="BtnIngestLink_Click"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- CURRENT ACTIVITY -->
                        <Border Style="{StaticResource CardBorder}" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Current activity" Style="{StaticResource SectionHeading}"/>
                                        <TextBlock Text="Live progress for the active worker task" FontSize="11" Foreground="#8491A4" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtProgressPercent" Grid.Column="1" Text="0%" FontSize="14" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                </Grid>
                                <ProgressBar x:Name="ProgressBarMain" Height="8" Minimum="0" Maximum="100" Value="0" Background="#E8EEF6" Foreground="#2563EB" BorderThickness="0"/>
                                <TextBlock x:Name="TxtProgressDetail" Text="No active upload" FontSize="11" Foreground="#64748B" Margin="0,9,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- QUEUE -->
                <ScrollViewer x:Name="PanelQueue" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24,28,30">
                        <TextBlock Text="Publishing queue" FontSize="23" FontWeight="Bold" Foreground="#172033"/>
                        <TextBlock Text="Review, manage and protect videos waiting to be published." FontSize="13" Foreground="#64748B" Margin="0,5,0,19"/>
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <Grid Margin="18,15,18,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Queued videos" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Upload thumbnail" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnUploadThumbnail_Click"/>
                                        <Button Content="Delete selected" Style="{StaticResource SecondaryButton}" Click="BtnDeleteQueueItem_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="GridQueue" MinHeight="300" MaxHeight="620" Margin="8,0,8,8" AutoGenerateColumns="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- FILES -->
                <ScrollViewer x:Name="PanelFiles" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24,28,30">
                        <TextBlock Text="Media files" FontSize="23" FontWeight="Bold" Foreground="#172033"/>
                        <TextBlock Text="Browse downloaded and managed media files." FontSize="13" Foreground="#64748B" Margin="0,5,0,19"/>
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <Grid Margin="18,15,18,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Downloads" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Open downloads folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="BtnOpenDownloadsFolder_Click"/>
                                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Click="BtnRefreshFiles_Click"/>
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="GridFiles" MinHeight="300" MaxHeight="620" Margin="8,0,8,8" AutoGenerateColumns="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- HISTORY -->
                <ScrollViewer x:Name="PanelHistory" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24,28,30">
                        <TextBlock Text="Upload history" FontSize="23" FontWeight="Bold" Foreground="#172033"/>
                        <TextBlock Text="Review previous publishing jobs and their outcomes." FontSize="13" Foreground="#64748B" Margin="0,5,0,19"/>
                        <Border Style="{StaticResource CardBorder}" Padding="0">
                            <StackPanel>
                                <TextBlock Text="Past activity" Style="{StaticResource SectionHeading}" Margin="18,16,18,12"/>
                                <DataGrid x:Name="GridHistory" MinHeight="300" MaxHeight="620" Margin="8,0,8,8" AutoGenerateColumns="True"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- SETTINGS: the named scrollviewer itself is toggled, avoiding an always-visible wrapper -->
                <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,24,28,30">
                        <TextBlock Text="Settings" FontSize="23" FontWeight="Bold" Foreground="#172033"/>
                        <TextBlock Text="Application folders and account configuration." FontSize="13" Foreground="#64748B" Margin="0,5,0,19"/>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Application data" Style="{StaticResource SectionHeading}"/>
                                <TextBlock Text="Your queue database, downloads and application data are stored in the configured data directory." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                <Button Content="Open downloads folder" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnOpenDownloadsFolder_Click"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="YouTube credentials" Style="{StaticResource SectionHeading}"/>
                                <TextBlock Text="Open the credentials directory to manage the OAuth client configuration. Keep credential files private." FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,7,0,14"/>
                                <Button Content="Open credentials folder" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="BtnOpenCredentialsFolder_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- BOTTOM STATUS BAR -->
            <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                <Grid Margin="20,0,20,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="10" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="S-MUSIC BOX AUTO SCHEDULER" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
